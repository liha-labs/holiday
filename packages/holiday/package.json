{
  "name": "@liha-labs/holiday",
  "version": "0.1.0",
  "description": "Japanese holiday library synced from official data",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "data"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./full": {
      "types": "./dist/full.d.ts",
      "import": "./dist/full.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/full.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
