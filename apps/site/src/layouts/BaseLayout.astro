---
const { title = "Official-data Japanese Holiday Library | @liha-labs/holiday" } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="@liha-labs/holiday は日本の祝日を公式データ準拠で提供する TypeScript ライブラリです。祝日計算ロジックを持たず、祝日名・曜日付き詳細を扱えます。"
    />
    <meta
      name="keywords"
      content="holiday,japan,祝日,typescript,esm,official data"
    />

    <meta name="google-site-verification" content="TVYUUoxlaYz2RLTyj3dkubUMZQBj32wCdP6c3hyd9nA" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://holiday.liha.dev/" />
    <meta property="og:title" content="@liha-labs/holiday" />
    <meta
      property="og:description"
      content="公式データ準拠の日本祝日ライブラリ。holidayName/isHoliday/getHoliday/list* を提供。"
    />
    <meta property="og:image" content="https://holiday.liha.dev/og-image.jpg" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://holiday.liha.dev/" />
    <meta property="twitter:title" content="@liha-labs/holiday" />
    <meta
      property="twitter:description"
      content="公式データ準拠の日本祝日ライブラリ。"
    />
    <meta property="twitter:image" content="https://holiday.liha.dev/og-image.jpg" />

    <title>{title}</title>
    <link rel="icon" href="/liha-lab-logo.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400..700&family=Plus+Jakarta+Sans:wght@400..800&family=Source+Code+Pro:wght@400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
